# Copy to .env on the Pi and fill in. .env is gitignored.

# Spec section 8: a LAN hostname, not an IP and not a Tailscale name. The Pi
# reaches the server over the plain LAN, never over Tailscale.
SERVER_URL=http://miniserver.local:8080

# The same token as the server's .env. Generate it there with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=replace-me-with-the-same-token-the-server-uses

# Always /dev/serial0, never ttyS0 or ttyAMA0. Spec section 3.
SERIAL_PORT=/dev/serial0

# BCM pin numbers. Switch closed (to ground) means remove.
SWITCH_GPIO=17
BUZZER_GPIO=27
LED_GPIO=22

# 0 to run without a buzzer or LED, e.g. on a laptop.
FEEDBACK_ENABLED=1
