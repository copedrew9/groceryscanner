# Copy to .env and fill in. .env is gitignored; this file holds placeholders only.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The server refuses to start if this is missing or under 32 characters.
# The same value goes in the scanner's .env and is typed into the web page.
API_TOKEN=replace-me-with-a-64-character-hex-token

# Open Food Facts asks that lookups identify themselves with a contact
# address. Product lookups are skipped entirely while this is unset.
CONTACT_EMAIL=you@example.com

# Set by compose.yaml for the container. Only needed when running locally.
# DB_PATH=./inventory.db
